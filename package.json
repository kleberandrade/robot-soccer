{
  "name": "robot-soccer",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@robot-soccer/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "coverage": "turbo run coverage",
    "typecheck": "turbo run typecheck",
    "simulate": "npm run simulate --workspace=@robot-soccer/simulator --",
    "db:migrate": "npm run migrate --workspace=@robot-soccer/database",
    "bridge": "npm run bridge --workspace=@robot-soccer/bridge --",
    "test:firmware": "c++ -std=c++17 tests/firmware.cpp -o /tmp/robot-soccer-firmware-test && /tmp/robot-soccer-firmware-test",
    "test:smoke": "node --import tsx tools/smoke.ts",
    "test:referee-smoke": "node --import tsx tools/referee-smoke.ts",
    "test:rooms-smoke": "node --import tsx tools/rooms-smoke.ts",
    "test:remote-clients": "node --import tsx tools/remote-clients-smoke.ts",
    "test:site-smoke": "node --import tsx tools/site-smoke.ts",
    "test:i18n-smoke": "node --import tsx tools/i18n-smoke.ts",
    "test:translations": "python3 tools/audit-translations.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.0",
    "fflate": "0.8.3",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
