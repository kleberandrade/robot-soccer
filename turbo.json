{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "MATCH_ADMIN_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [],
      "cache": false
    },
    "coverage": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [
        "coverage/**"
      ],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    }
  },
  "globalDependencies": [
    "tsconfig.base.json",
    "vitest.config.ts",
    "docs/**/*.md",
    "hardware/**",
    "README.md",
    "firmware/src/main.cpp",
    "firmware/include/protocol.h",
    "firmware/include/secrets.example.h",
    "firmware/platformio.ini",
    "tools/sync-hardware.ts"
  ]
}
